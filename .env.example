# ==============================================
# CHEAP_ACCOMMODATION - ENVIRONMENT CONFIGURATION
# ==============================================
# Copy file này thành .env và điền các giá trị thực.
# KHÔNG commit .env vào version control — chỉ commit .env.example

# ----------------------------------------------
# Application Configuration
# ----------------------------------------------
NODE_ENV=development
APP_NAME=cheap_accommodation
APP_TIMEZONE=Asia/Ho_Chi_Minh

# ----------------------------------------------
# Database Configuration
# PostgreSQL MỚI — tách biệt hoàn toàn với admin_orderlist
# Host Postgres port: 5433 (admin_orderlist dùng 5432)
# ----------------------------------------------
DATABASE_URL=postgresql://accom_admin:CHANGE_ME@127.0.0.1:5433/cheap_accom_db
DB_USER=accom_admin
DB_PASS=CHANGE_ME
DB_NAME=cheap_accom_db

# Database Schemas
DB_SCHEMA_ACCOMMODATION=accommodation
DB_SCHEMA_PAYMENTS=payments
SCHEMA_ACCOMMODATION=accommodation
SCHEMA_PAYMENTS=payments

# ----------------------------------------------
# Server Configuration
# Backend port: 3002 (admin_orderlist dùng 3001)
# ----------------------------------------------
PORT=3002
FRONTEND_ORIGINS=http://localhost:5174,http://localhost:2102,https://timtro247.com,https://www.timtro247.com
PUBLIC_BASE_URL=https://timtro247.com

# ----------------------------------------------
# Session Configuration
# ----------------------------------------------
SESSION_SECRET=CHANGE_THIS_TO_A_STRONG_RANDOM_STRING
SESSION_NAME=cheap_accom.sid
COOKIE_SECURE=auto

# ----------------------------------------------
# Redis Configuration
# Redis port: 6380 (admin_orderlist dùng 6379)
# ----------------------------------------------
REDIS_URL=redis://127.0.0.1:6380

# ----------------------------------------------
# Telegram Bot Configuration (Thông báo nội bộ)
# ----------------------------------------------
TELEGRAM_BOT_TOKEN=CHANGE_ME
TELEGRAM_CHAT_ID=CHANGE_ME
SEND_NOTIFICATION=true

# Topic IDs
TELEGRAM_GENERAL_TOPIC_ID=1
ERROR_TOPIC_ID=2

# ----------------------------------------------
# Payment QR Code Configuration (VietQR) — nếu cần
# ----------------------------------------------
# ORDER_QR_ACCOUNT_NUMBER=
# ORDER_QR_BANK_CODE=VPB
# ORDER_QR_ACCOUNT_NAME=
# ORDER_QR_NOTE_PREFIX=Tien thue phong

# ----------------------------------------------
# Frontend Build (Vite build-time)
# ----------------------------------------------
VITE_API_BASE_URL=https://api.timtro247.com

# ----------------------------------------------
# Database Backup (Google Drive) — tùy chọn
# ----------------------------------------------
ENABLE_DB_BACKUP=false
# BACKUP_DATABASE_URL=postgresql://accom_admin:CHANGE_ME@127.0.0.1:5433/cheap_accom_db
# GOOGLE_DRIVE_FOLDER_ID=
# BACKUP_RETENTION_DAYS=7
# GOOGLE_DRIVE_OAUTH_CLIENT_ID=
# GOOGLE_DRIVE_OAUTH_CLIENT_SECRET=
# GOOGLE_DRIVE_OAUTH_REFRESH_TOKEN=

# ----------------------------------------------
# Scheduler / Cron Configuration
# ----------------------------------------------
CRON_SCHEDULE_RENT_REMINDER=0 8 1 * *
RUN_CRON_ON_START=false

# ----------------------------------------------
# Logging
# ----------------------------------------------
# LOG_LEVEL=info
# LOG_FILE=./logs/app.log
